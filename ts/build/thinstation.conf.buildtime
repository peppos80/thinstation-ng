Ini, TOML
# --- Impostazioni Generali e Localizzazione ---
AUDIO_LEVEL=90
MIC_LEVEL=0
TIME_ZONE=Europe/Rome
NET_TIME_SERVER=it.pool.ntp.org
LOCALE=it_IT

# --- Rete e DHCP ---
NET_USE=BOTH
NET_USE_DHCP=on
NET_HOSTNAME=ts-*
NET_REMOTE_ACCESS_FROM="0.0.0.0"
TFTP_BLOCKSIZE=8192
USB_STORAGE_SYNC=on

# --- Risoluzione Monitor ---
SET_RESOLUTION_MULTIMONITOR_EXPAND='mirror'
SET_RESOLUTION_MULTIMONITOR_AUTOSCALE='scale'

# --- Sicurezza e Blocco Hardening ---
NO_CONSOLE=On
BIND_CONSOLE=Off
LEAVE_X_BEFORE_REBOOT=On
REBOOT_SERVER_OFF=On

# --- Configurazione Sessione Chiosco Chrome ---
SESSION_0_TYPE=chrome
SESSION_0_TITLE="Citrix Workspace Web"
SESSION_0_AUTOSTART=On

# Imposta l'URL esatto della pagina Citrix aziendale
CHROME_HOMEPAGE="https://virtualcomputing.agenziadogane.it/"

# Parametri per bloccare Chrome in Kiosk Mode
CHROME_OPTIONS="--kiosk --no-first-run --disable-translate --disable-infobars --disable-suggestions-ui --disable-save-password-bubble --incognito https://citrix.tuaazienda.it"
